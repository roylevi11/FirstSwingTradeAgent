# העתק/י קובץ זה ל-.env ומלא/י את המפתח האמיתי שלך.
# את המפתח מקבלים ב: https://console.anthropic.com/settings/keys
# חשוב: קובץ .env עצמו לא אמור להיכנס ל-Git (ראו .gitignore).

ANTHROPIC_API_KEY=your_key_here

# --- עבור server/ (בוט טלגרם) - ראו server/DEPLOY.md ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
